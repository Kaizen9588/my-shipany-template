# -----------------------------------------------------------------------------
# Web Information
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WEB_URL = "http://localhost:3000"
NEXT_PUBLIC_PROJECT_NAME = "my-shipany-template"

# -----------------------------------------------------------------------------
# Database with Supabase
# -----------------------------------------------------------------------------
# https://supabase.com/docs/guides/getting-started/quickstarts/nextjs
# Set your Supabase URL and Anon Key
SUPABASE_URL = ""
SUPABASE_ANON_KEY = ""
SUPABASE_SERVICE_ROLE_KEY = ""
# PostgreSQL 连接串（迁移机制 P-1.12 使用；推荐 Supabase 连接池事务模式）
# 示例: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL = ""

# -----------------------------------------------------------------------------
# Auth with next-auth
# https://authjs.dev/getting-started/installation?framework=Next.js
# Set your Auth URL and Secret
# Secret can be generated with `openssl rand -base64 32`
# -----------------------------------------------------------------------------
# ⚠️ 必填，禁止留空/复用示例值：JWT 会话签名密钥，泄漏或共享等于可伪造任意用户登录态。
# 生成：openssl rand -base64 32
AUTH_SECRET = ""

# 自托管 next start / 非标准域名时需要显式信任域名（Auth.js v5）
# Vercel / 本地 pnpm dev 不需要；文档见 docs/08-config-env.md
AUTH_TRUST_HOST = "false"

# Google Auth
# https://authjs.dev/getting-started/providers/google
AUTH_GOOGLE_ID = ""
AUTH_GOOGLE_SECRET = ""
NEXT_PUBLIC_AUTH_GOOGLE_ID = ""
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED = "false"
NEXT_PUBLIC_AUTH_GOOGLE_ONE_TAP_ENABLED = "false"

# Github Auth
# https://authjs.dev/getting-started/providers/github
AUTH_GITHUB_ID = ""
AUTH_GITHUB_SECRET = ""
NEXT_PUBLIC_AUTH_GITHUB_ENABLED = "false"

# -----------------------------------------------------------------------------
# Analytics with Google Analytics
# https://analytics.google.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID = ""

# -----------------------------------------------------------------------------
# Analytics with OpenPanel
# https://openpanel.dev
# -----------------------------------------------------------------------------
NEXT_PUBLIC_OPENPANEL_CLIENT_ID = ""

# -----------------------------------------------------------------------------
# Payment with Stripe
# https://docs.stripe.com/keys
# -----------------------------------------------------------------------------
STRIPE_PUBLIC_KEY = ""
STRIPE_PRIVATE_KEY = ""
STRIPE_WEBHOOK_SECRET = ""

NEXT_PUBLIC_PAY_SUCCESS_URL = "http://localhost:3000/my-orders"
NEXT_PUBLIC_PAY_FAIL_URL = "http://localhost:3000/#pricing"
NEXT_PUBLIC_PAY_CANCEL_URL = "http://localhost:3000/#pricing"

# -----------------------------------------------------------------------------
# Payment with Creem（6.1 多渠道；配置后自动启用，热切换走 payment_settings 表）
# https://creem.io
# -----------------------------------------------------------------------------
CREEM_API_KEY = ""
CREEM_WEBHOOK_SECRET = ""

# -----------------------------------------------------------------------------
# Payment with Waffo Pancake（2026-08 迁移至 @waffo/pancake-ts，操作指南：
# docs/payment/waffo-operations-guide.md §三；凭据收敛为 2 项）
# https://docs.waffo.ai
# -----------------------------------------------------------------------------
# 商户 ID（MER_ 前缀）
WAFFO_MERCHANT_ID = ""
# 商户 RSA 私钥（PEM，多行）；托管平台/CI 无法存多行时改用下面的 BASE64
WAFFO_PRIVATE_KEY = ""
# PEM 的 BASE64 编码（与上者二选一，优先级更高）
WAFFO_PRIVATE_KEY_BASE64 = ""
# 旧代变量 WAFFO_API_KEY / WAFFO_PUBLIC_KEY 已废弃（Pancake 验签公钥内置于 SDK）

NEXT_PUBLIC_LOCALE_DETECTION = "false"

ADMIN_EMAILS = ""
# 初始超级管理员：仅显式设置邮箱时才会在迁移阶段创建，未设置则绝不建号。
# 可选：不填密码时会生成一次性临时密码，仅写入受限启动日志；首次登录必须立即改密。
ADMIN_BOOTSTRAP_EMAIL = ""
ADMIN_BOOTSTRAP_PASSWORD = ""

NEXT_PUBLIC_DEFAULT_THEME = "light"

# -----------------------------------------------------------------------------
# 告警通知（docs/16，后台 /admin/notify 也可配置，优先级高于此环境变量）
# -----------------------------------------------------------------------------
FEISHU_WEBHOOK_URL = ""
FEISHU_SECRET = ""
WECOM_WEBHOOK_URL = ""
NOTIFY_MIN_SEVERITY = "warn"

# Snowflake workerId（多实例部署时每实例唯一，避免订单号重复；P-1.11）
SNOWFLAKE_WORKER_ID = "1"

# CORS 允许的跨域来源（逗号分隔；未配置默认拒绝跨域；P-1.10）
# 例: https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS = ""

# IP 信任拓扑（第四轮审查 S1，第五轮 2.16 默认值收敛）：决定 getClientIp 只信任哪个平台覆写头
# - none（默认）：不信任任何代理头，取 socket 直连地址 -- 最安全默认，本地/dev 均适用
# - vercel：只信 x-forwarded-for 首跳（Vercel 平台覆写整个头，可安全信任）
# - cloudflare：只信 cf-connecting-ip（源站建议防火墙限到 CF 网段）
# ⚠️ Docker/自托管必须显式声明真实拓扑：自建 nginx 是 append 而非覆写代理头，
#    误配 vercel 时攻击者可逐请求伪造 X-Forwarded-For 绕过全部 IP 限流
TRUSTED_PROXY = "none"

# -----------------------------------------------------------------------------
# AI 网关闭环 & 免费试用（6.0 / 6.0.1）
# -----------------------------------------------------------------------------
# 模型提供方密钥（docs/13；配置哪个启用哪个，模型白名单见 data/model-pricing.ts）
OPENAI_API_KEY = ""
DEEPSEEK_API_KEY = ""
OPENROUTER_API_KEY = ""
SILICONFLOW_API_KEY = ""
SILICONFLOW_BASE_URL = ""
REPLICATE_API_TOKEN = ""
KLING_API_KEY = ""
KLING_BASE_URL = ""

# 未登录用户每日免费演示次数（默认 3）
ANONYMOUS_DAILY_LIMIT = "3"
# 演示使用的模型（必须在 data/model-pricing.ts 白名单内，默认 deepseek-chat）
DEMO_MODEL = "deepseek-chat"
# 演示输出上限（默认 1024 tokens，防止白嫖长输出）
DEMO_MAX_TOKENS = "1024"
# 匿名演示 prompt 字节上限，超限 413 且照常消耗次数（P0-4，默认 8192）
DEMO_MAX_PROMPT_BYTES = "8192"
# 匿名演示同一 IP 当日失败次数封顶，达到后当日拒绝（P0-4，默认 10）
DEMO_FAILURE_DAILY_LIMIT = "10"
# 匿名演示分钟级 IP 限流（默认 30 次/分钟）
DEMO_RATELIMIT_PER_MIN = "30"
# 已废弃：x-device-id 头客户端可伪造，匿名额度键已改为纯 IP（第四轮审查 S3）
# ANONYMOUS_FINGERPRINT_ENABLED = "true"

# -----------------------------------------------------------------------------
# Email with Resend（6.2；配置后启用邮件，未配置时静默跳过）
# https://resend.com
# -----------------------------------------------------------------------------
RESEND_API_KEY = ""
# 发件人地址，如 "MySaaS <noreply@example.com>"
EMAIL_FROM = ""
# 积分低余额提醒阈值（默认 10）
CREDIT_LOW_THRESHOLD = "10"

# -----------------------------------------------------------------------------
# Feedback with Crisp（6.3；空值时不加载）
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CRISP_WEBSITE_ID = ""

# -----------------------------------------------------------------------------
# Email & Password login（6.4）
# -----------------------------------------------------------------------------
# bcrypt 密码哈希成本因子（默认 12）
BCRYPT_SALT_ROUNDS = "12"

# -----------------------------------------------------------------------------
# Telemetry with PostHog（6.5；未配置时埋点静默跳过）
# https://posthog.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY = ""
# 自托管 / EU 节点地址（默认 https://us.i.posthog.com）
NEXT_PUBLIC_POSTHOG_HOST = ""

# -----------------------------------------------------------------------------
# 运营只读指标接口（/api/metrics、/api/metrics/events）—— 飞书多维表格「数据接入」数据源
# 鉴权：请求头 `Authorization: Bearer <METRICS_ACCESS_SECRET>`。生产必填，未配则接口拒绝。
# 生成方法：openssl rand -hex 32（一串长随机十六进制，勿提交，只放环境变量/密钥服务）。
# 安全：只读 GET + 限流（见 lib/metrics-auth.ts）；独特密钥只有你知道，URL 曝光也调不动。
# ⚠️ 不要把 METRICS_ACCESS_SECRET 填进飞书多维表格截图/文档/回显，只在飞书数据源鉴权头里配置。
METRICS_ACCESS_SECRET = ""

# -----------------------------------------------------------------------------
# Feishu 多维表格（bitable）运维对接（运营大屏数据源 + 快照推送）
# 说明：
#  - /api/metrics（只读聚合，应用内）用作数据源，供脚本/外部只读拉取。
#  - 应用侧不直接写飞书；推送由本机 lark-cli 脚本 scripts/lark/base_sync.sh
#    完成（token 由 lark-cli 自身管理，不落在应用凭据里）。
#  - 以下保留占位，供后续需要「应用内写飞书」时启用（Mimosa 会审查出网代码）。
# LARK_APP_ID = ""
# LARK_APP_SECRET = ""
# BITABLE_APP_TOKEN = ""
# BITABLE_ORDERS_TABLE_ID = ""
# BITABLE_REFUNDS_TABLE_ID = ""
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Cron / Backup（6.16；Vercel Cron 自动带 Authorization: Bearer <CRON_SECRET>）
# ⚠️ 生产必填（第五轮 2.13）：未设置时 /api/cron/daily 拒绝执行（该端点会触发全量表备份导出）
CRON_SECRET = ""

# -----------------------------------------------------------------------------
# Rate limit with Upstash（6.18；未配置时降级为内存限流）
# https://upstash.com
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL = ""
UPSTASH_REDIS_REST_TOKEN = ""

# -----------------------------------------------------------------------------
# Storage with aws s3 sdk
# https://docs.aws.amazon.com/s3/index.html
# -----------------------------------------------------------------------------
STORAGE_ENDPOINT = ""
STORAGE_REGION = ""
STORAGE_ACCESS_KEY = ""
STORAGE_SECRET_KEY = ""
STORAGE_BUCKET = ""
STORAGE_DOMAIN = ""
# 文件 key 前缀（默认项目名，替代硬编码 "shipany/"，P-1.8）
STORAGE_PREFIX = ""